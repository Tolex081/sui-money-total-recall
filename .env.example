# Copy to .env.local and edit privately. Never put secrets in this template.
APP_MODE=mock
APP_ORIGIN=http://localhost:3000
# Wallet identity sign-in is separate from personal financial access.
WALLET_SIGNIN_ENABLED=false
# Read-only personal balance/activity is a separate release from edits and budgeting.
PERSONAL_READ_ENABLED=false
# Keep personal budget changes and memory writes gated until their release checks pass.
PERSONAL_ACCESS_ENABLED=false
PERSONAL_LABELS_ENABLED=false
# Sending USDC: the server builds through Tatum, the user's own wallet signs, the server submits. Needs PERSONAL_READ_ENABLED.
PERSONAL_SEND_ENABLED=false
# Plan for real wallets on top of the read pilot. Needs PERSONAL_READ_ENABLED and PERSONAL_LABELS_ENABLED.
PERSONAL_PLAN_ENABLED=false
DATABASE_URL=
TATUM_API_KEY=
TATUM_GRPC_TARGET=sui-mainnet-grpc.gateway.tatum.io:443
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE_DEMO=suimoney-demo-v1
MEMWAL_NAMESPACE_SECRET=
SESSION_SECRET=
INTERNAL_ADMIN_SECRET=
REFERENCE_SUI_ADDRESS=
REFERENCE_TRANSACTION_DIGESTS=
MEMWAL_FREE_WRITES_CONFIRMED=false
