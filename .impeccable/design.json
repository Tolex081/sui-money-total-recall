  "narrative": {
    "northStar": "Wallet facts. Remembered context.",
    "overview": "This phrase comes from the implemented landing illustration caption. It describes the established identity: pale cream-green canvas, white working surfaces, deep-green financial emphasis, and a mint memory surface. A spacious landing introduces a denser account workspace. Self-hosted Figtree supports everyday tasks; Bricolage Grotesque gives the landing and wordmark a distinct voice.\n\nOfficial event artwork adds personality without competing with amounts or warnings. Tatum identifies wallet observations; Walrus identifies confirmed context. Provider marks communicate provenance, not endorsement or live verification of the fictional demo. Asset provenance and ownership are recorded in `docs/BRAND_ASSETS.md`.",
    "keyCharacteristics": [
      "Pale tonal surfaces and fine borders establish grouping.",
      "Large amounts lead; their units and source remain adjacent.",
      "Dark backings preserve the unchanged white provider wordmarks.",
      "The mascot accompanies explanations and leaves controls clear."
    ],
    "rules": [
      {
        "name": "The Provenance Rule",
        "body": "Provider identity describes the source of facts or context. A provider mark must not turn synthetic finance into verified personal evidence.",
        "section": "colors"
      },
      {
        "name": "The Amount and Unit Rule",
        "body": "Keep the amount visually dominant while retaining its unit, provenance, and estimate qualifier in the same reading group.",
        "section": "typography"
      },
      {
        "name": "The Tonal Surface Rule",
        "body": "Use tonal grouping and fine borders for ordinary cards. Preserve elevated treatment for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use tonal surfaces and fine borders for ordinary cards.",
      "Do retain adjacent units, source labels, and planning qualifiers around financial amounts.",
      "Do use the existing local provider assets with their unchanged proportions and readable dark backing.",
      "Do preserve keyboard focus, reduced-motion behavior, and mascot clearance at mobile widths."
    ],
    "donts": [
      "Don't imply sponsor endorsement or give synthetic finance a live-verification badge.",
      "Don't let artwork obscure amounts, controls, provenance, or security warnings.",
      "Don't reproduce legacy eyebrows or substitute text glyphs for interface icons on new surfaces.",
      "Don't extend compact 11px metadata styling into financial explanations, forms, or general prose."
    ]
  }
}
