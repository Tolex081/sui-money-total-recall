  "narrative": {
    "northStar": "A clear view of what moved, what remains, and what comes next.",
    "overview": "The user supplied a cool blue-and-white SaaS reference. Sui Money applies its ice-blue canvas, clean white surfaces and cobalt actions to a wallet product whose facts and context have distinct sources. Tatum identifies verified wallet observations; Walrus Memory identifies confirmed context and corrections. The real Walrus mascot holding the Tatum mark is used as the product illustration. The fictional demo remains clearly labelled.",
    "keyCharacteristics": [
      "Cool blue-white surfaces, dark readable ink and cobalt for primary actions.",
      "The labelled navigation keeps Today, Activity and Plan discoverable.",
      "Tatum is the source label for wallet facts; Walrus is the source label for confirmed context.",
      "Financial units, status, provenance and uncertainty stay beside every amount."
    ],
    "rules": [
      {
        "name": "The Provenance Rule",
        "body": "Provider identity describes the source of facts or context. A provider mark must not turn synthetic finance into verified personal evidence.",
        "section": "colors"
      },
      {
        "name": "The Amount and Unit Rule",
        "body": "Keep the amount visually dominant while retaining its unit, provenance, and estimate qualifier in the same reading group.",
        "section": "typography"
      },
      {
        "name": "The Two-Source Rule",
        "body": "Tatum labels onchain observations. Walrus labels confirmed context. Neither integration changes custody, payments, or financial release gates.",
        "section": "components"
      }
    ],
    "dos": [
      "Use the cool blue palette with flat, readable surfaces and one primary action.",
      "Retain adjacent units, source labels, and planning qualifiers around financial amounts.",
      "Use official local provider assets with their proportions and a readable dark backing.",
      "Preserve labelled navigation, keyboard focus, reduced motion, and mobile mascot clearance."
    ],
    "donts": [
      "Do not imply sponsor endorsement or give synthetic finance a live-verification badge.",
      "Do not let artwork obscure amounts, controls, provenance, or security warnings.",
      "Do not use decorative blur, glass, gradients, or glowing cards.",
      "Do not extend compact metadata styling into financial explanations, forms, or general prose."
    ]
  },
